{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corporate_action_payload.schema.json",
  "title": "Normalized corporate-action payload for adjustment views",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "action_type",
    "symbol",
    "security_id",
    "effective_date",
    "status",
    "revision",
    "previous_record_sha256",
    "split_ratio_numerator",
    "split_ratio_denominator",
    "cash_amount",
    "currency",
    "original_provider"
  ],
  "properties": {
    "action_id": {"type": "string"},
    "action_type": {"enum": ["split", "cash_dividend"]},
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
    "security_id": {"type": ["string", "null"]},
    "effective_date": {"type": "string", "format": "date"},
    "status": {"enum": ["active", "corrected", "rescinded"]},
    "revision": {"type": "integer", "minimum": 1},
    "previous_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "split_ratio_numerator": {"type": ["string", "null"]},
    "split_ratio_denominator": {"type": ["string", "null"]},
    "cash_amount": {"type": ["string", "null"]},
    "currency": {"type": ["string", "null"]},
    "original_provider": {"type": "string"}
  }
}
