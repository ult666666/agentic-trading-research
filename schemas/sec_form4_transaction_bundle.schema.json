{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charles.local/schemas/sec_form4_transaction_bundle.schema.json",
  "title": "SEC Form 4 Transaction Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "parser_version", "policy_version", "policy_path", "policy_sha256",
    "source_request_path", "source_request_file_sha256", "source_xml_path",
    "source_xml_file_sha256", "generated_utc", "knowledge_cutoff_utc",
    "accession_number", "accepted_at_utc", "retrieved_at_utc", "source_url",
    "document", "issuer", "reporting_owner_count", "reporting_owners", "transactions",
    "summary", "limitations", "safety", "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "sec_form4_transaction_bundle/1.0"},
    "parser_version": {"const": "1.0.0"},
    "policy_version": {"const": "1.0.0"},
    "policy_path": {"type": "string", "minLength": 1, "maxLength": 500},
    "policy_sha256": {"$ref": "#/$defs/sha"},
    "source_request_path": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_request_file_sha256": {"$ref": "#/$defs/sha"},
    "source_xml_path": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_xml_file_sha256": {"$ref": "#/$defs/sha"},
    "generated_utc": {"$ref": "#/$defs/utc"},
    "knowledge_cutoff_utc": {"$ref": "#/$defs/utc"},
    "accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "accepted_at_utc": {"$ref": "#/$defs/utc"},
    "retrieved_at_utc": {"$ref": "#/$defs/utc"},
    "source_url": {"type": "string", "minLength": 40, "maxLength": 500},
    "document": {"$ref": "#/$defs/document"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "reporting_owner_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "reporting_owners": {
      "type": "array", "maxItems": 50,
      "items": {"$ref": "#/$defs/owner"}
    },
    "transactions": {
      "type": "array", "maxItems": 5000,
      "items": {"$ref": "#/$defs/transaction"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "limitations": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "safety": {"$ref": "#/$defs/safety"},
    "artifact_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"},
    "date": {"type": "string", "format": "date"},
    "nullableDate": {"type": ["string", "null"], "format": "date"},
    "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,159}$"},
    "nullableDecimal": {
      "type": ["string", "null"],
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": [
        "document_type", "is_amendment", "period_of_report", "date_of_original_submission",
        "not_subject_to_section_16", "form_10b5_1_checkbox", "form_10b5_1_scope",
        "footnote_count", "signature_count", "non_derivative_holding_count",
        "derivative_holding_count"
      ],
      "properties": {
        "document_type": {"enum": ["4", "4/A"]},
        "is_amendment": {"type": "boolean"},
        "period_of_report": {"$ref": "#/$defs/date"},
        "date_of_original_submission": {"$ref": "#/$defs/nullableDate"},
        "not_subject_to_section_16": {"type": ["boolean", "null"]},
        "form_10b5_1_checkbox": {"type": ["boolean", "null"]},
        "form_10b5_1_scope": {"const": "filing_level_transaction_scope_not_deterministically_attributed"},
        "footnote_count": {"type": "integer", "minimum": 0},
        "signature_count": {"type": "integer", "minimum": 0},
        "non_derivative_holding_count": {"type": "integer", "minimum": 0},
        "derivative_holding_count": {"type": "integer", "minimum": 0}
      }
    },
    "issuer": {
      "type": "object", "additionalProperties": false,
      "required": ["cik", "symbol", "foreign_trading_symbol"],
      "properties": {
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"},
        "foreign_trading_symbol": {"type": ["string", "null"], "maxLength": 32}
      }
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": [
        "owner_id_sha256", "is_director", "is_officer", "is_ten_percent_owner",
        "is_other", "officer_title_disclosed", "other_role_text_disclosed", "role_count",
        "owner_sha256"
      ],
      "properties": {
        "owner_id_sha256": {"$ref": "#/$defs/sha"},
        "is_director": {"type": ["boolean", "null"]},
        "is_officer": {"type": ["boolean", "null"]},
        "is_ten_percent_owner": {"type": ["boolean", "null"]},
        "is_other": {"type": ["boolean", "null"]},
        "officer_title_disclosed": {"type": "boolean"},
        "other_role_text_disclosed": {"type": "boolean"},
        "role_count": {"type": "integer", "minimum": 0, "maximum": 4},
        "owner_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "derivativeDetails": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "conversion_or_exercise_price", "exercise_date", "expiration_date",
        "underlying_security_title", "underlying_security_shares"
      ],
      "properties": {
        "conversion_or_exercise_price": {"$ref": "#/$defs/nullableDecimal"},
        "exercise_date": {"$ref": "#/$defs/nullableDate"},
        "expiration_date": {"$ref": "#/$defs/nullableDate"},
        "underlying_security_title": {"type": ["string", "null"], "maxLength": 300},
        "underlying_security_shares": {"$ref": "#/$defs/nullableDecimal"}
      }
    },
    "transaction": {
      "type": "object", "additionalProperties": false,
      "required": [
        "transaction_id", "table", "table_index", "security_title", "transaction_date",
        "deemed_execution_date", "transaction_form_type", "transaction_code",
        "transaction_timeliness", "equity_swap_involved", "acquired_disposed_code",
        "direction", "classification", "shares", "price_per_share", "reported_notional",
        "post_transaction_shares", "ownership_form", "indirect_nature_disclosed",
        "derivative_details", "footnote_reference_count", "semantic_status", "risk_flags",
        "structured_purchase_code_candidate", "open_market_confirmed",
        "private_purchase_excluded", "form_10b5_1_scope_unknown",
        "grants_insider_purchase_confirmation", "transaction_sha256"
      ],
      "properties": {
        "transaction_id": {"type": "string", "pattern": "^form4_tx:[0-9a-f]{64}$"},
        "table": {"enum": ["non_derivative", "derivative"]},
        "table_index": {"type": "integer", "minimum": 0},
        "security_title": {"type": "string", "minLength": 1, "maxLength": 300},
        "transaction_date": {"$ref": "#/$defs/date"},
        "deemed_execution_date": {"$ref": "#/$defs/nullableDate"},
        "transaction_form_type": {"type": ["string", "null"], "maxLength": 16},
        "transaction_code": {"type": "string", "pattern": "^[A-Z]$"},
        "transaction_timeliness": {"type": ["string", "null"], "maxLength": 8},
        "equity_swap_involved": {"type": ["boolean", "null"]},
        "acquired_disposed_code": {"enum": ["A", "D", null]},
        "direction": {"enum": ["acquisition", "disposition", "unknown"]},
        "classification": {"$ref": "#/$defs/token"},
        "shares": {"$ref": "#/$defs/nullableDecimal"},
        "price_per_share": {"$ref": "#/$defs/nullableDecimal"},
        "reported_notional": {"$ref": "#/$defs/nullableDecimal"},
        "post_transaction_shares": {"$ref": "#/$defs/nullableDecimal"},
        "ownership_form": {"enum": ["direct", "indirect", "unknown"]},
        "indirect_nature_disclosed": {"type": "boolean"},
        "derivative_details": {"$ref": "#/$defs/derivativeDetails"},
        "footnote_reference_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "semantic_status": {"enum": ["valid", "incomplete", "conflicted"]},
        "risk_flags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "structured_purchase_code_candidate": {"type": "boolean"},
        "open_market_confirmed": {"const": false},
        "private_purchase_excluded": {"const": false},
        "form_10b5_1_scope_unknown": {"type": "boolean"},
        "grants_insider_purchase_confirmation": {"const": false},
        "transaction_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "countMap": {
      "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "transaction_count", "non_derivative_transaction_count",
        "derivative_transaction_count", "valid_transaction_count",
        "incomplete_transaction_count", "conflicted_transaction_count",
        "structured_purchase_code_candidate_count", "open_market_confirmed_count",
        "transaction_code_counts", "classification_counts", "direction_counts",
        "footnote_count", "reporting_owner_count", "grants_insider_purchase_confirmation"
      ],
      "properties": {
        "transaction_count": {"type": "integer", "minimum": 0},
        "non_derivative_transaction_count": {"type": "integer", "minimum": 0},
        "derivative_transaction_count": {"type": "integer", "minimum": 0},
        "valid_transaction_count": {"type": "integer", "minimum": 0},
        "incomplete_transaction_count": {"type": "integer", "minimum": 0},
        "conflicted_transaction_count": {"type": "integer", "minimum": 0},
        "structured_purchase_code_candidate_count": {"type": "integer", "minimum": 0},
        "open_market_confirmed_count": {"const": 0},
        "transaction_code_counts": {"$ref": "#/$defs/countMap"},
        "classification_counts": {"$ref": "#/$defs/countMap"},
        "direction_counts": {"$ref": "#/$defs/countMap"},
        "footnote_count": {"type": "integer", "minimum": 0},
        "reporting_owner_count": {"type": "integer", "minimum": 0},
        "grants_insider_purchase_confirmation": {"const": false}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": [
        "research_only", "diagnostic_only", "external_network_invoked", "model_invoked",
        "broker_access", "account_data_allowed", "raw_xml_persisted_in_output",
        "reporting_owner_pii_persisted", "feeds_production", "feeds_buy_gate",
        "feeds_production_scoring", "grants_insider_purchase_confirmation",
        "grants_catalyst_confirmation", "strategy_change_allowed", "risk_limit_change_allowed",
        "counts_in_metrics", "execution_enabled"
      ],
      "properties": {
        "research_only": {"const": true},
        "diagnostic_only": {"const": true},
        "external_network_invoked": {"const": false},
        "model_invoked": {"const": false},
        "broker_access": {"const": "none"},
        "account_data_allowed": {"const": false},
        "raw_xml_persisted_in_output": {"const": false},
        "reporting_owner_pii_persisted": {"const": false},
        "feeds_production": {"const": false},
        "feeds_buy_gate": {"const": false},
        "feeds_production_scoring": {"const": false},
        "grants_insider_purchase_confirmation": {"const": false},
        "grants_catalyst_confirmation": {"const": false},
        "strategy_change_allowed": {"const": false},
        "risk_limit_change_allowed": {"const": false},
        "counts_in_metrics": {"const": false},
        "execution_enabled": {"const": false}
      }
    }
  }
}
