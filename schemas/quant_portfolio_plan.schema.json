{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant_portfolio_plan.schema.json",
  "title": "Quant Portfolio Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source_backtest_plan_sha256",
    "cost_policy_sha256",
    "portfolio_policy_sha256",
    "allocations",
    "safety"
  ],
  "properties": {
    "schema": {"const": "quant_portfolio_plan/1.0"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_backtest_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cost_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portfolio_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "symbol", "event_date", "specified_at_utc", "priority", "requested_weight", "sector", "catalyst_type", "cost_context"],
        "properties": {
          "scenario_id": {"type": "string"},
          "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
          "event_date": {"type": "string", "format": "date"},
          "specified_at_utc": {"type": "string", "format": "date-time"},
          "priority": {"type": "integer", "minimum": 1},
          "requested_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "sector": {"type": "string"},
          "catalyst_type": {"type": "string"},
          "cost_context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observed_at_utc", "decision_cutoff_utc", "spread_bps", "daily_volatility_bps", "fraction_of_adv", "source_artifact_sha256"],
            "properties": {
              "observed_at_utc": {"type": "string", "format": "date-time"},
              "decision_cutoff_utc": {"type": "string", "format": "date-time"},
              "spread_bps": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "daily_volatility_bps": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "fraction_of_adv": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_only", "diagnostic_only", "execution_enabled", "activation_authority", "feeds_production", "strategy_change_allowed", "broker_access", "normalized_capital_only", "account_data_allowed", "share_recommendation_allowed", "actual_order_simulation"],
      "properties": {
        "research_only": {"const": true},
        "diagnostic_only": {"const": true},
        "execution_enabled": {"const": false},
        "activation_authority": {"const": false},
        "feeds_production": {"const": false},
        "strategy_change_allowed": {"const": false},
        "broker_access": {"const": "none"},
        "normalized_capital_only": {"const": true},
        "account_data_allowed": {"const": false},
        "share_recommendation_allowed": {"const": false},
        "actual_order_simulation": {"const": false}
      }
    }
  }
}
