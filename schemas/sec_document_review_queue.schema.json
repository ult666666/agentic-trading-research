{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sec_document_review_queue.schema.json",
  "title": "Deterministic SEC document-review queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "target_session_date", "generated_utc", "knowledge_cutoff_utc",
    "policy_path", "policy_sha256", "source_event_bundle_path",
    "source_event_bundle_file_sha256", "source_event_bundle_sha256",
    "source_eligible_filing_count", "task_count",
    "complete_eligible_filing_denominator", "agent_name", "retrieval_policy", "tasks",
    "summary", "safety", "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "sec_document_review_queue/1.0"},
    "version": {"const": "1.0.0"},
    "target_session_date": {"type": "string", "format": "date"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "knowledge_cutoff_utc": {"type": "string", "format": "date-time"},
    "policy_path": {"type": "string", "minLength": 1},
    "policy_sha256": {"$ref": "#/$defs/sha"},
    "source_event_bundle_path": {"type": "string", "minLength": 1},
    "source_event_bundle_file_sha256": {"$ref": "#/$defs/sha"},
    "source_event_bundle_sha256": {"$ref": "#/$defs/sha"},
    "source_eligible_filing_count": {"type": "integer", "minimum": 0},
    "task_count": {"type": "integer", "minimum": 0},
    "complete_eligible_filing_denominator": {"const": true},
    "agent_name": {"const": "sec-ir-verification-agent"},
    "retrieval_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["source_domain", "request_rate_limit_per_second", "requires_descriptive_user_agent", "raw_source_persisted"],
      "properties": {
        "source_domain": {"const": "www.sec.gov"},
        "request_rate_limit_per_second": {"type": "integer", "minimum": 1, "maximum": 10},
        "requires_descriptive_user_agent": {"const": true},
        "raw_source_persisted": {"const": false}
      }
    },
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["priority_counts", "form_counts", "item_code_counts", "missing_primary_document_count", "unknown_form_count", "unknown_item_count"],
      "properties": {
        "priority_counts": {"$ref": "#/$defs/counts"},
        "form_counts": {"$ref": "#/$defs/counts"},
        "item_code_counts": {"$ref": "#/$defs/counts"},
        "missing_primary_document_count": {"type": "integer", "minimum": 0},
        "unknown_form_count": {"type": "integer", "minimum": 0},
        "unknown_item_count": {"type": "integer", "minimum": 0}
      }
    },
    "safety": {"$ref": "sec_document_review_policy.schema.json#/$defs/safety"},
    "artifact_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,95}$"},
    "tokenList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "agent_name", "status", "accession_number", "entity_id", "symbol",
        "form", "form_recognized", "is_amendment", "accepted_at_utc", "source_filing_sha256", "priority",
        "priority_rank", "priority_reasons", "filing_index_url", "directory_index_url",
        "filing_directory_url", "primary_document_url", "item_codes",
        "standalone_item_codes", "supplemental_item_codes", "unknown_item_codes",
        "required_fact_fields", "mandatory_checks", "prohibited_inferences",
        "expected_result_draft_schema", "task_sha256"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^sec_review:[0-9a-f]{64}$"},
        "agent_name": {"const": "sec-ir-verification-agent"},
        "status": {"const": "pending"},
        "accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "entity_id": {"type": "string", "pattern": "^cik:[0-9]{10}$"},
        "symbol": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$"},
        "form": {"type": "string", "minLength": 1, "maxLength": 32},
        "form_recognized": {"type": "boolean"},
        "is_amendment": {"type": "boolean"},
        "accepted_at_utc": {"type": "string", "format": "date-time"},
        "source_filing_sha256": {"$ref": "#/$defs/sha"},
        "priority": {"enum": ["critical", "high", "normal"]},
        "priority_rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "priority_reasons": {"$ref": "#/$defs/tokenList"},
        "filing_index_url": {"type": "string", "format": "uri"},
        "directory_index_url": {"type": "string", "format": "uri"},
        "filing_directory_url": {"type": "string", "format": "uri"},
        "primary_document_url": {"type": ["string", "null"], "format": "uri"},
        "item_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{2}$"}},
        "standalone_item_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{2}$"}},
        "supplemental_item_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{2}$"}},
        "unknown_item_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{2}$"}},
        "required_fact_fields": {"$ref": "#/$defs/tokenList"},
        "mandatory_checks": {"$ref": "#/$defs/tokenList"},
        "prohibited_inferences": {"$ref": "#/$defs/tokenList"},
        "expected_result_draft_schema": {"const": "sec_document_review_result_draft/1.0"},
        "task_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
