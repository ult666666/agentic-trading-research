{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant_strategy_shadow_event.schema.json",
  "title": "Quant Strategy Shadow Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "tool", "plan_id", "sequence", "event_type", "recorded_at_utc",
    "previous_event_sha256", "policy_sha256", "plan_sha256", "payload",
    "research_only", "diagnostic_only", "execution_enabled", "activation_authority",
    "strategy_change_allowed", "feeds_production", "feeds_research_factory", "feeds_buy_gate",
    "profitability_claim_allowed", "automatic_promotion_allowed", "automatic_shadow_start_allowed",
    "registry_mutation_allowed", "broker_access", "broker_tool_invoked", "account_data_allowed",
    "order_data_allowed", "network_allowed", "model_invoked", "event_sha256"
  ],
  "properties": {
    "schema": {"const": "quant_strategy_shadow_event/1.0"},
    "tool": {"const": "quant.strategy_shadow_monitor"},
    "plan_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
    "event_type": {"enum": ["plan_anchor", "observation"]},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "previous_event_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "policy_sha256": {"$ref": "#/$defs/sha"}, "plan_sha256": {"$ref": "#/$defs/sha"},
    "payload": {"oneOf": [{"$ref": "#/$defs/anchor_payload"}, {"$ref": "#/$defs/observation_payload"}]},
    "research_only": {"const": true}, "diagnostic_only": {"const": true},
    "execution_enabled": {"const": false}, "activation_authority": {"const": false},
    "strategy_change_allowed": {"const": false}, "feeds_production": {"const": false},
    "feeds_research_factory": {"const": false}, "feeds_buy_gate": {"const": false},
    "profitability_claim_allowed": {"const": false}, "automatic_promotion_allowed": {"const": false},
    "automatic_shadow_start_allowed": {"const": false}, "registry_mutation_allowed": {"const": false},
    "broker_access": {"const": "none"}, "broker_tool_invoked": {"const": false},
    "account_data_allowed": {"const": false}, "order_data_allowed": {"const": false},
    "network_allowed": {"const": false}, "model_invoked": {"const": false},
    "event_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy_id", "net_return", "active", "gross_exposure"],
      "properties": {
        "strategy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "net_return": {"type": ["number", "null"], "minimum": -0.5, "maximum": 0.5},
        "active": {"type": ["boolean", "null"]},
        "gross_exposure": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "anchor_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_path", "plan_file_sha256", "plan_sha256"],
      "properties": {
        "plan_path": {"type": "string", "pattern": "^data/runtime/(experiments|health|quant)/[^\\u0000]+$"},
        "plan_file_sha256": {"$ref": "#/$defs/sha"},
        "plan_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "observation_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["session_date", "state", "draft_path", "draft_file_sha256",
                   "draft_sha256", "candidate", "benchmark", "incumbents", "reason_codes"],
      "properties": {
        "session_date": {"$ref": "#/$defs/date"},
        "state": {"enum": ["complete", "unavailable"]},
        "draft_path": {"type": "string", "pattern": "^data/runtime/(experiments|health|quant)/[^\\u0000]+$"},
        "draft_file_sha256": {"$ref": "#/$defs/sha"},
        "draft_sha256": {"$ref": "#/$defs/sha"},
        "candidate": {"$ref": "#/$defs/observation"},
        "benchmark": {"$ref": "#/$defs/observation"},
        "incumbents": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/observation"}},
        "reason_codes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
