{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sec_document_review_result_draft.schema.json",
  "title": "Untrusted SEC document-review result draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent_name", "target_session_date", "generated_utc", "status", "reviews"],
  "properties": {
    "schema": {"const": "sec_document_review_result_draft/1.0"},
    "agent_name": {"const": "sec-ir-verification-agent"},
    "target_session_date": {"type": "string", "format": "date"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "partial", "failed"]},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/reviewDraft"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,95}$"},
    "receiptDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "retrieved_at_utc", "content_sha256", "document_kind", "content_type", "http_status", "raw_source_persisted"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "retrieved_at_utc": {"type": "string", "format": "date-time"},
        "content_sha256": {"$ref": "#/$defs/sha"},
        "document_kind": {"enum": ["filing_index", "directory_index", "primary_document", "exhibit", "complete_submission"]},
        "content_type": {"enum": ["html", "xml", "text", "json", "pdf"]},
        "http_status": {"const": 200},
        "raw_source_persisted": {"const": false}
      }
    },
    "factDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_field", "value_status", "normalized_value", "units", "exact_excerpt", "citation_url", "event_effective_date", "issuer_only"],
      "properties": {
        "fact_field": {"$ref": "#/$defs/token"},
        "value_status": {"enum": ["present", "missing", "unavailable", "conflicted"]},
        "normalized_value": {"type": ["string", "number", "boolean", "null"]},
        "units": {"type": ["string", "null"], "maxLength": 64},
        "exact_excerpt": {"type": ["string", "null"], "maxLength": 500},
        "citation_url": {"type": ["string", "null"], "format": "uri"},
        "event_effective_date": {"type": ["string", "null"], "format": "date"},
        "issuer_only": {"type": "boolean"}
      }
    },
    "reviewDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "disposition", "completed_checks", "source_receipts", "facts", "could_not_verify", "dilution_or_financing_risk", "prompt_injection_detected"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^sec_review:[0-9a-f]{64}$"},
        "disposition": {"enum": ["verified", "refuted", "partial", "conflicted", "unavailable"]},
        "completed_checks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "source_receipts": {"type": "array", "items": {"$ref": "#/$defs/receiptDraft"}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/factDraft"}},
        "could_not_verify": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "dilution_or_financing_risk": {"enum": ["found", "not_found", "unknown"]},
        "prompt_injection_detected": {"type": "boolean"}
      }
    }
  }
}
