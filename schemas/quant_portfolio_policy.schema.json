{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant_portfolio_policy.schema.json",
  "title": "Quant Portfolio Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "allocation_method",
    "initial_normalized_nav",
    "maximum_gross_exposure",
    "maximum_net_exposure",
    "maximum_position_weight",
    "minimum_position_weight",
    "maximum_sector_weight",
    "maximum_catalyst_weight",
    "maximum_aggregate_stop_risk",
    "maximum_open_positions",
    "maximum_entries_per_session",
    "one_position_per_symbol",
    "direction",
    "leverage_allowed",
    "shorting_allowed",
    "entry_order_rule",
    "exit_proceeds_rule",
    "mark_to_market_rule",
    "cost_application_rule",
    "missing_data_rule",
    "safety"
  ],
  "properties": {
    "schema": {"const": "quant_portfolio_policy/1.0"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "allocation_method": {"const": "priority_order_constrained_requested_weight"},
    "initial_normalized_nav": {"const": 1.0},
    "maximum_gross_exposure": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maximum_net_exposure": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maximum_position_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "minimum_position_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maximum_sector_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maximum_catalyst_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maximum_aggregate_stop_risk": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maximum_open_positions": {"type": "integer", "minimum": 1},
    "maximum_entries_per_session": {"type": "integer", "minimum": 1},
    "one_position_per_symbol": {"const": true},
    "direction": {"const": "long_only"},
    "leverage_allowed": {"const": false},
    "shorting_allowed": {"const": false},
    "entry_order_rule": {"const": "ascending_priority_then_scenario_id"},
    "exit_proceeds_rule": {"const": "not_reusable_for_same_session_entries"},
    "mark_to_market_rule": {"const": "daily_close_with_modeled_exit_price_on_exit_date"},
    "cost_application_rule": {"const": "maximum_of_backtest_floor_and_predecision_cost_estimate"},
    "missing_data_rule": {"const": "skip_candidate_or_fail_artifact_never_impute_zero"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_only", "diagnostic_only", "execution_enabled", "activation_authority", "feeds_production", "strategy_change_allowed", "broker_access", "normalized_capital_only", "account_data_allowed", "share_recommendation_allowed", "actual_order_simulation"],
      "properties": {
        "research_only": {"const": true},
        "diagnostic_only": {"const": true},
        "execution_enabled": {"const": false},
        "activation_authority": {"const": false},
        "feeds_production": {"const": false},
        "strategy_change_allowed": {"const": false},
        "broker_access": {"const": "none"},
        "normalized_capital_only": {"const": true},
        "account_data_allowed": {"const": false},
        "share_recommendation_allowed": {"const": false},
        "actual_order_simulation": {"const": false}
      }
    }
  }
}
