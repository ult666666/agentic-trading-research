{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant_cost_estimate.schema.json",
  "title": "Quant Cost Estimate",
  "type": "object",
  "required": [
    "schema",
    "policy_version",
    "policy_sha256",
    "context_sha256",
    "observed_at_utc",
    "decision_cutoff_utc",
    "status",
    "usable_for_portfolio_backtest",
    "reasons",
    "missing_inputs",
    "stress_multiplier",
    "components_bps_per_side",
    "unstressed_cost_bps_per_side",
    "modeled_cost_bps_per_side",
    "fill_probability",
    "fill_probability_reason",
    "actual_orders_count",
    "estimate_sha256",
    "diagnostic_only",
    "feeds_production",
    "execution_enabled"
  ],
  "properties": {
    "schema": {"const": "quant_cost_estimate/1.0"},
    "policy_version": {"type": "string"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "decision_cutoff_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["estimated", "unestimable", "capacity_rejected", "rejected_future_input"]},
    "usable_for_portfolio_backtest": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "missing_inputs": {"type": "array", "items": {"type": "string"}},
    "stress_multiplier": {"type": "number", "minimum": 1},
    "components_bps_per_side": {"type": "object"},
    "unstressed_cost_bps_per_side": {"type": ["number", "null"]},
    "modeled_cost_bps_per_side": {"type": ["number", "null"]},
    "fill_probability": {"const": null},
    "fill_probability_reason": {"type": "string"},
    "actual_orders_count": {"const": 0},
    "estimate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnostic_only": {"const": true},
    "feeds_production": {"const": false},
    "execution_enabled": {"const": false}
  }
}
