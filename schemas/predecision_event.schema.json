{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predecision_event.schema.json",
  "title": "Pre-decision event ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_type",
    "sequence",
    "event_id",
    "observation_id",
    "run_id",
    "attempt_id",
    "trading_date",
    "issuer_id",
    "security_id",
    "listing_id",
    "symbol_asof",
    "source_id",
    "source_document_id",
    "source_payload_sha256",
    "raw_payload_id",
    "semantic_payload_sha256",
    "semantic_batch_id",
    "observation_receipt_id",
    "source_schema_version",
    "normalizer_version",
    "retrieval_metadata_sha256",
    "published_at",
    "effective_at",
    "first_seen_at",
    "observed_at",
    "cutoff_at",
    "appended_at",
    "event_type",
    "claim_fingerprint",
    "syndication_group_id",
    "eligibility_state",
    "rejection_codes",
    "conflict_state",
    "stage_reached",
    "model_version",
    "prompt_hash",
    "artifact_parent_hashes",
    "terminal_state",
    "freeze_candidate_id",
    "correction_of_observation_id",
    "outcome_eligible_at",
    "draft_sha256",
    "previous_record_sha256",
    "safety",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": "predecision_event/1.0"},
    "record_type": {
      "enum": ["event_observation", "source_receipt", "run_terminal"]
    },
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {
      "type": ["string", "null"],
      "pattern": "^event:[0-9a-f]{64}$"
    },
    "observation_id": {"type": "string", "pattern": "^observation:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "trading_date": {"type": "string", "format": "date"},
    "issuer_id": {"$ref": "#/$defs/nullableIdentifier"},
    "security_id": {"$ref": "#/$defs/nullableIdentifier"},
    "listing_id": {"$ref": "#/$defs/nullableIdentifier"},
    "symbol_asof": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
    "source_id": {"$ref": "#/$defs/identifier"},
    "source_document_id": {"$ref": "#/$defs/identifier"},
    "source_payload_sha256": {"$ref": "#/$defs/sha256"},
    "raw_payload_id": {"type": "string", "pattern": "^raw:[0-9a-f]{64}$"},
    "semantic_payload_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_batch_id": {"type": "string", "pattern": "^semantic:[0-9a-f]{64}$"},
    "observation_receipt_id": {"type": "string", "pattern": "^receipt:[0-9a-f]{64}$"},
    "source_schema_version": {"$ref": "#/$defs/identifier"},
    "normalizer_version": {"$ref": "#/$defs/identifier"},
    "retrieval_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "published_at": {"$ref": "#/$defs/nullableUtc"},
    "effective_at": {"$ref": "#/$defs/nullableUtc"},
    "first_seen_at": {"$ref": "#/$defs/utc"},
    "observed_at": {"$ref": "#/$defs/utc"},
    "cutoff_at": {"$ref": "#/$defs/utc"},
    "appended_at": {"$ref": "#/$defs/utc"},
    "event_type": {"$ref": "#/$defs/identifier"},
    "claim_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "syndication_group_id": {"$ref": "#/$defs/nullableIdentifier"},
    "eligibility_state": {
      "enum": [
        "discovered",
        "eligible_for_enrichment",
        "rejected",
        "conflicted",
        "incomplete",
        "no_trade",
        "unknown",
        "not_applicable"
      ]
    },
    "rejection_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "conflict_state": {"enum": ["none", "unresolved", "resolved", "unknown", "not_applicable"]},
    "stage_reached": {
      "enum": [
        "intake",
        "snapshot",
        "discovery",
        "evidence",
        "adjudication",
        "authority_and_risk",
        "synthesis",
        "freeze",
        "terminal"
      ]
    },
    "model_version": {"$ref": "#/$defs/nullableIdentifier"},
    "prompt_hash": {"$ref": "#/$defs/nullableSha256"},
    "artifact_parent_hashes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "terminal_state": {"$ref": "#/$defs/identifier"},
    "freeze_candidate_id": {"$ref": "#/$defs/nullableIdentifier"},
    "correction_of_observation_id": {
      "type": ["string", "null"],
      "pattern": "^observation:[0-9a-f]{64}$"
    },
    "outcome_eligible_at": {"$ref": "#/$defs/nullableUtc"},
    "draft_sha256": {"$ref": "#/$defs/sha256"},
    "previous_record_sha256": {"$ref": "#/$defs/nullableSha256"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "diagnostic_only",
        "predecision_only",
        "execution_enabled",
        "feeds_production",
        "feeds_buy_gate",
        "feeds_production_scoring",
        "grants_official_status",
        "grants_buy_authority",
        "grants_price_authority",
        "counts_in_metrics",
        "strategy_activation_allowed",
        "broker_access"
      ],
      "properties": {
        "research_only": {"const": true},
        "diagnostic_only": {"const": true},
        "predecision_only": {"const": true},
        "execution_enabled": {"const": false},
        "feeds_production": {"const": false},
        "feeds_buy_gate": {"const": false},
        "feeds_production_scoring": {"const": false},
        "grants_official_status": {"const": false},
        "grants_buy_authority": {"const": false},
        "grants_price_authority": {"const": false},
        "counts_in_metrics": {"const": false},
        "strategy_activation_allowed": {"const": false},
        "broker_access": {"const": "none"}
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "nullableIdentifier": {
      "type": ["string", "null"],
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"},
    "nullableUtc": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"}
  }
}
