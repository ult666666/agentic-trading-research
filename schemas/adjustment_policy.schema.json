{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjustment_policy.schema.json",
  "title": "Point-in-time bar adjustment policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "supported_views",
    "supported_action_types",
    "split_ratio_convention",
    "split_price_rule",
    "split_volume_rule",
    "cash_dividend_price_rule",
    "cash_dividend_reference_rule",
    "cash_dividend_currency",
    "effective_date_rule",
    "future_observation_rule",
    "future_effective_action_rule",
    "revision_rule",
    "unsupported_action_rule",
    "output_decimal_places",
    "minimum_cash_factor",
    "safety"
  ],
  "properties": {
    "schema": {"const": "adjustment_policy_config/1.0"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supported_views": {"const": ["raw", "split_only", "total_return"]},
    "supported_action_types": {"const": ["split", "cash_dividend"]},
    "split_ratio_convention": {"const": "new_shares_per_old_share"},
    "split_price_rule": {"const": "pre_effective_prices_divided_by_ratio"},
    "split_volume_rule": {"const": "pre_effective_volume_multiplied_by_ratio"},
    "cash_dividend_price_rule": {"const": "pre_ex_date_prices_times_previous_close_minus_cash_over_previous_close"},
    "cash_dividend_reference_rule": {"const": "latest_unadjusted_close_before_effective_date"},
    "cash_dividend_currency": {"const": "USD"},
    "effective_date_rule": {"const": "apply_only_when_effective_date_not_after_snapshot_cutoff_date"},
    "future_observation_rule": {"const": "reject_record_observed_after_snapshot_cutoff"},
    "future_effective_action_rule": {"const": "exclude_without_adjusting_history"},
    "revision_rule": {"const": "linear_contiguous_hash_chain_latest_revision_wins_rescind_removes"},
    "unsupported_action_rule": {"const": "fail_closed"},
    "output_decimal_places": {"type": "integer", "minimum": 4, "maximum": 12},
    "minimum_cash_factor": {"type": "string", "pattern": "^0\\.[0-9]+$"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research_only": {"const": true},
        "diagnostic_only": {"const": true},
        "execution_enabled": {"const": false},
        "activation_authority": {"const": false},
        "feeds_production_scoring": {"const": false},
        "strategy_change_allowed": {"const": false},
        "raw_bars_immutable": {"const": true},
        "provider_adjusted_values_are_not_relabelled_as_policy_views": {"const": true},
        "source_provider_required": {"const": true},
        "broker_access": {"const": "none"}
      },
      "required": [
        "research_only",
        "diagnostic_only",
        "execution_enabled",
        "activation_authority",
        "feeds_production_scoring",
        "strategy_change_allowed",
        "raw_bars_immutable",
        "provider_adjusted_values_are_not_relabelled_as_policy_views",
        "source_provider_required",
        "broker_access"
      ]
    }
  }
}
