{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider_bakeoff_observation.schema.json",
  "title": "Provider bake-off observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "provider",
    "target_session_date",
    "generated_utc",
    "adapter_version",
    "source_capture_sha256",
    "fixture_catalog_sha256",
    "metrics",
    "cutoff_checks",
    "corrections",
    "return_samples_bps",
    "replay_checks",
    "faults",
    "morning_availability",
    "collection",
    "cost_usd",
    "storage_bytes",
    "license_attestation_id",
    "research_only",
    "production_authority",
    "execution_enabled",
    "feeds_production_scoring",
    "strategy_activation_allowed",
    "contains_account_data",
    "contains_credentials",
    "raw_payload_persisted",
    "observation_sha256"
  ],
  "properties": {
    "schema": {"const": "provider_bakeoff_observation/1.0"},
    "campaign_id": {"type": "string"},
    "provider": {"enum": ["massive_bakeoff", "databento_bakeoff"]},
    "target_session_date": {"type": "string", "format": "date"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "adapter_version": {"type": "string"},
    "source_capture_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "metrics": {"type": "object"},
    "cutoff_checks": {"type": "array"},
    "corrections": {"type": "array"},
    "return_samples_bps": {"type": "array"},
    "replay_checks": {"type": "array"},
    "faults": {"type": "array"},
    "morning_availability": {"type": "object"},
    "collection": {"type": "object"},
    "cost_usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "storage_bytes": {"type": "integer", "minimum": 0},
    "license_attestation_id": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "research_only": {"const": true},
    "production_authority": {"const": false},
    "execution_enabled": {"const": false},
    "feeds_production_scoring": {"const": false},
    "strategy_activation_allowed": {"const": false},
    "contains_account_data": {"const": false},
    "contains_credentials": {"const": false},
    "raw_payload_persisted": {"const": false},
    "observation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
