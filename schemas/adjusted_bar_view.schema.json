{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjusted_bar_view.schema.json",
  "title": "Cutoff-aware derived bar view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "policy_sha256",
    "snapshot_id",
    "snapshot_sha256",
    "knowledge_cutoff_utc",
    "as_of_date",
    "view",
    "source_provider",
    "bars",
    "bar_lineage",
    "action_lineage",
    "counts",
    "roundtrip",
    "quant_compatible",
    "quant_validation_errors",
    "bars_payload_sha256",
    "lineage_sha256",
    "dataset_id",
    "research_only",
    "diagnostic_only",
    "execution_enabled",
    "activation_authority",
    "feeds_production_scoring",
    "strategy_change_allowed",
    "broker_access",
    "view_sha256"
  ],
  "properties": {
    "schema": {"const": "adjusted_bar_view/1.0"},
    "policy_version": {"type": "string"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "knowledge_cutoff_utc": {"type": "string", "format": "date-time"},
    "as_of_date": {"type": "string", "format": "date"},
    "view": {"enum": ["raw", "split_only", "total_return"]},
    "source_provider": {"type": "string"},
    "bars": {"type": "object"},
    "bar_lineage": {"type": "array"},
    "action_lineage": {"type": "array"},
    "counts": {"type": "object"},
    "roundtrip": {"type": "object"},
    "quant_compatible": {"type": "boolean"},
    "quant_validation_errors": {"type": "array", "items": {"type": "string"}},
    "bars_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lineage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "research_only": {"const": true},
    "diagnostic_only": {"const": true},
    "execution_enabled": {"const": false},
    "activation_authority": {"const": false},
    "feeds_production_scoring": {"const": false},
    "strategy_change_allowed": {"const": false},
    "broker_access": {"const": "none"},
    "view_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
