{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charles.local/schemas/natural_run_acceptance_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "target_session_date", "generated_utc", "status", "observation_eligible",
    "operational_acceptance", "research_output_acceptance",
    "broker_audit_canary_eligible", "profitability_evidence_established",
    "promotion_authorized", "production_gate_enforced", "reasons", "checks", "inputs",
    "evidence", "safety", "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "natural_run_acceptance/1.1"},
    "target_session_date": {"type": "string", "format": "date"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pending", "accepted", "observed_not_accepted", "blocked", "not_applicable"]},
    "observation_eligible": {"type": "boolean"},
    "operational_acceptance": {"type": "boolean"},
    "research_output_acceptance": {"type": "boolean"},
    "broker_audit_canary_eligible": {"type": "boolean"},
    "profitability_evidence_established": {"const": false},
    "promotion_authorized": {"const": false},
    "production_gate_enforced": {"const": false},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/checkMarketDay"},
        {"$ref": "#/$defs/checkTerminalTime"},
        {"$ref": "#/$defs/checkNaturalAttempts"},
        {"$ref": "#/$defs/checkPostCloseFinality"},
        {"$ref": "#/$defs/checkServiceHealth"},
        {"$ref": "#/$defs/checkWorkflowOutcomes"},
        {"$ref": "#/$defs/checkServiceSlos"},
        {"$ref": "#/$defs/checkScheduler"},
        {"$ref": "#/$defs/checkPower"},
        {"$ref": "#/$defs/checkBrokerRuntime"},
        {"$ref": "#/$defs/checkReleaseProvenance"},
        {"$ref": "#/$defs/checkPreSessionReadiness"},
        {"$ref": "#/$defs/checkFreezeIntegrity"},
        {"$ref": "#/$defs/checkCandidateBundle"},
        {"$ref": "#/$defs/checkResearchOutput"},
        {"$ref": "#/$defs/checkBrokerLaneCoverage"},
        {"$ref": "#/$defs/checkSafety"}
      ],
      "items": false
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_sha256", "autonomy_state_sha256", "freeze_receipt_sha256",
        "broker_sli_sha256", "readiness_sha256", "candidate_bundle_sha256",
        "post_close_terminal_receipt_sha256"
      ],
      "properties": {
        "health_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "autonomy_state_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "freeze_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "broker_sli_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "readiness_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "candidate_bundle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "post_close_terminal_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "natural_attempt_states", "workflow_statuses", "service_slo_statuses",
        "broker_runtime", "release", "readiness", "research", "candidate_bundle",
        "post_close_finality"
      ],
      "properties": {
        "natural_attempt_states": {"$ref": "#/$defs/workflowStatuses"},
        "workflow_statuses": {"$ref": "#/$defs/workflowStatuses"},
        "service_slo_statuses": {"$ref": "#/$defs/workflowStatuses"},
        "broker_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status", "receipt_count", "complete_receipt_count", "broker_read_attempt_total",
            "broker_preview_write_attempt_total", "unknown_broker_attempt_total", "lane_coverage"
          ],
          "properties": {
            "status": {"type": "string"},
            "receipt_count": {"type": "integer", "minimum": 0},
            "complete_receipt_count": {"type": "integer", "minimum": 0},
            "broker_read_attempt_total": {"type": "integer", "minimum": 0},
            "broker_preview_write_attempt_total": {"type": "integer", "minimum": 0},
            "unknown_broker_attempt_total": {"type": "integer", "minimum": 0},
            "lane_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["morning", "postclose", "postopen"],
              "properties": {
                "morning": {"type": "boolean"},
                "postclose": {"type": "boolean"},
                "postopen": {"type": "boolean"}
              }
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "snapshot_id"],
          "properties": {
            "status": {"type": "string"},
            "snapshot_id": {"type": ["string", "null"]}
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "artifact_sha256"],
          "properties": {
            "status": {"type": "string"},
            "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freeze_present", "freeze_valid", "official", "buy_authorized", "classification",
            "freshness_evaluated", "fresh_claim_count", "stale_claim_count",
            "invalid_claim_count"
          ],
          "properties": {
            "freeze_present": {"type": "boolean"},
            "freeze_valid": {"type": "boolean"},
            "official": {"type": "boolean"},
            "buy_authorized": {"type": "boolean"},
            "classification": {"enum": [
              null,
              "OFFICIAL_RESEARCH_WATCH",
              "OFFICIAL_RESEARCH_NO_TRADE",
              "OFFICIAL_RESEARCH_CONDITIONAL_PLAN",
              "OFFICIAL_RESEARCH_BUY_PROPOSAL",
              "PRELIMINARY_LIVE_PRICE_RESEARCH_INCOMPLETE",
              "PRELIMINARY_PRICE_UNAVAILABLE",
              "PRELIMINARY_CATALYST_UNVERIFIED",
              "PRELIMINARY_PORTFOLIO_CONTEXT_UNAVAILABLE",
              "NON_TRADING_DAY",
              "RUN_FAILURE"
            ]},
            "freshness_evaluated": {"type": "boolean"},
            "fresh_claim_count": {"type": "integer", "minimum": 0},
            "stale_claim_count": {"type": "integer", "minimum": 0},
            "invalid_claim_count": {"type": "integer", "minimum": 0}
          }
        },
        "candidate_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present", "valid", "artifact_path", "artifact_sha256", "source",
            "candidate_count", "dropped_count", "official_research",
            "run_buy_authorized", "report_sha256"
          ],
          "properties": {
            "present": {"type": "boolean"},
            "valid": {"type": "boolean"},
            "artifact_path": {"type": ["string", "null"], "pattern": "^data/runtime/research/20[0-9]{2}-[0-9]{2}-[0-9]{2}/candidates\\.json$"},
            "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "source": {"type": ["string", "null"], "enum": [null, "structured_draft", "report_extractor_fallback", "none"]},
            "candidate_count": {"type": "integer", "minimum": 0},
            "dropped_count": {"type": "integer", "minimum": 0},
            "official_research": {"type": "boolean"},
            "run_buy_authorized": {"type": "boolean"},
            "report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "post_close_finality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present", "valid", "receipt_path", "receipt_sha256", "artifact_sha256",
            "cutoff_artifact_sha256", "report_sha256", "run_id", "state", "outcome"
          ],
          "properties": {
            "present": {"type": "boolean"},
            "valid": {"type": "boolean"},
            "receipt_path": {"type": ["string", "null"], "pattern": "^data/runtime/post_close_runs/20[0-9]{2}-[0-9]{2}-[0-9]{2}/postclose-20[0-9]{6}T[0-9]{6}Z-[0-9a-f]{12}/terminal_receipt\\.json$"},
            "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "cutoff_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "run_id": {"type": ["string", "null"], "pattern": "^postclose-20[0-9]{6}T[0-9]{6}Z-[0-9a-f]{12}$"},
            "state": {"enum": [null, "completed", "degraded", "skipped", "failed", "blocked"]},
            "outcome": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:/-]{1,180}$"}
          }
        }
      }
    },
    "safety": {"$ref": "#/$defs/safety"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "required": ["operational_acceptance"],
        "properties": {"operational_acceptance": {"const": true}}
      },
      "then": {
        "properties": {
          "inputs": {
            "properties": {
              "health_sha256": {"type": "string"},
              "autonomy_state_sha256": {"type": "string"},
              "freeze_receipt_sha256": {"type": "string"},
              "broker_sli_sha256": {"type": "string"},
              "readiness_sha256": {"type": "string"},
              "candidate_bundle_sha256": {"type": "string"},
              "post_close_terminal_receipt_sha256": {"type": "string"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "accepted"}}
      },
      "then": {"properties": {"operational_acceptance": {"const": true}}}
    },
    {
      "if": {
        "required": ["broker_audit_canary_eligible"],
        "properties": {"broker_audit_canary_eligible": {"const": true}}
      },
      "then": {"properties": {"operational_acceptance": {"const": true}}}
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason_codes"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["pass", "warn", "fail", "not_applicable"]},
        "reason_codes": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,159}$"}
        }
      }
    },
    "checkMarketDay": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "market_day"}}}]},
    "checkTerminalTime": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "terminal_time"}}}]},
    "checkNaturalAttempts": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "natural_attempts"}}}]},
    "checkPostCloseFinality": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "post_close_finality"}}}]},
    "checkServiceHealth": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "service_health"}}}]},
    "checkWorkflowOutcomes": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "workflow_outcomes"}}}]},
    "checkServiceSlos": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "service_slos"}}}]},
    "checkScheduler": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "scheduler"}}}]},
    "checkPower": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "power"}}}]},
    "checkBrokerRuntime": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "broker_runtime"}}}]},
    "checkReleaseProvenance": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "release_provenance"}}}]},
    "checkPreSessionReadiness": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "pre_session_readiness"}}}]},
    "checkFreezeIntegrity": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "freeze_integrity"}}}]},
    "checkCandidateBundle": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "candidate_bundle"}}}]},
    "checkResearchOutput": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "research_output"}}}]},
    "checkBrokerLaneCoverage": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "broker_lane_coverage"}}}]},
    "checkSafety": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "safety"}}}]},
    "workflowStatuses": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"maxProperties": 0},
        {"required": ["intake", "macro_refresh", "morning", "post_open", "post_close"]}
      ],
      "properties": {
        "intake": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
        "macro_refresh": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
        "morning": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
        "post_open": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
        "post_close": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only", "diagnostic_only", "local_artifact_write_only", "network_invoked",
        "model_invoked", "broker_invoked", "execution_enabled", "strategy_change_allowed",
        "risk_limit_change_allowed", "promotion_authorized", "production_gate_enforced"
      ],
      "properties": {
        "read_only": {"const": true},
        "diagnostic_only": {"const": true},
        "local_artifact_write_only": {"const": true},
        "network_invoked": {"const": false},
        "model_invoked": {"const": false},
        "broker_invoked": {"const": false},
        "execution_enabled": {"const": false},
        "strategy_change_allowed": {"const": false},
        "risk_limit_change_allowed": {"const": false},
        "promotion_authorized": {"const": false},
        "production_gate_enforced": {"const": false}
      }
    }
  }
}
