{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider_bakeoff_scorecard.schema.json",
  "title": "Provider bake-off rollup scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "config_sha256",
    "generated_utc",
    "status",
    "required_sessions",
    "valid_receipt_count",
    "provider_rollup",
    "cross_provider",
    "license_gate",
    "hard_gate_failures",
    "quality_threshold_failures",
    "collection_gaps",
    "roles_recommendation",
    "research_only",
    "production_authority",
    "execution_enabled",
    "feeds_production_scoring",
    "strategy_activation_allowed",
    "governance_approval_required",
    "scorecard_sha256"
  ],
  "properties": {
    "schema": {"const": "provider_bakeoff_scorecard/1.0"},
    "campaign_id": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["collecting", "blocked", "hard_gate_failed", "quality_failed", "candidate_for_governance_review"]},
    "required_sessions": {"type": "integer", "minimum": 1},
    "valid_receipt_count": {"type": "integer", "minimum": 0},
    "provider_rollup": {"type": "object"},
    "cross_provider": {"type": "object"},
    "license_gate": {"type": "object"},
    "hard_gate_failures": {"type": "array", "items": {"type": "string"}},
    "quality_threshold_failures": {"type": "array", "items": {"type": "string"}},
    "collection_gaps": {"type": "array", "items": {"type": "string"}},
    "roles_recommendation": {"type": ["object", "null"]},
    "research_only": {"const": true},
    "production_authority": {"const": false},
    "execution_enabled": {"const": false},
    "feeds_production_scoring": {"const": false},
    "strategy_activation_allowed": {"const": false},
    "governance_approval_required": {"const": true},
    "scorecard_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
