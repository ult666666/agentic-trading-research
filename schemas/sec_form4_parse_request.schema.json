{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charles.local/schemas/sec_form4_parse_request.schema.json",
  "title": "SEC Form 4 Parse Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "accession_number", "issuer_cik", "symbol", "accepted_at_utc",
    "retrieved_at_utc", "knowledge_cutoff_utc", "source_url", "content_sha256",
    "raw_source_persisted_in_output"
  ],
  "properties": {
    "schema": {"const": "sec_form4_parse_request/1.0"},
    "accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "issuer_cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"},
    "accepted_at_utc": {"$ref": "#/$defs/utc"},
    "retrieved_at_utc": {"$ref": "#/$defs/utc"},
    "knowledge_cutoff_utc": {"$ref": "#/$defs/utc"},
    "source_url": {
      "type": "string", "minLength": 40, "maxLength": 500,
      "pattern": "^https://www\\.sec\\.gov/Archives/edgar/data/[0-9]+/[0-9]{18}/[A-Za-z0-9][A-Za-z0-9._-]*\\.xml$"
    },
    "content_sha256": {"$ref": "#/$defs/sha"},
    "raw_source_persisted_in_output": {"const": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"}
  }
}
