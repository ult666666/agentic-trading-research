{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charles.local/schemas/operator_console_policy.schema.json",
  "title": "Operator Console Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "bind_host",
    "default_port",
    "static_root",
    "cache_seconds",
    "minimum_forced_refresh_seconds",
    "diagnostic_timeout_seconds",
    "maximum_response_bytes",
    "maximum_request_bytes",
    "maximum_static_bytes",
    "maximum_reports",
    "control_policy",
    "allowed_api_routes",
    "allowed_methods",
    "allowed_diagnostics",
    "security_headers",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "operator_console_policy/1.3"
    },
    "version": {
      "const": "1.3.0"
    },
    "bind_host": {
      "const": "127.0.0.1"
    },
    "default_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "static_root": {
      "const": "web/dist"
    },
    "cache_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60
    },
    "minimum_forced_refresh_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "diagnostic_timeout_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 30
    },
    "maximum_response_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 1048576
    },
    "maximum_request_bytes": {
      "const": 4096
    },
    "maximum_static_bytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 10485760
    },
    "maximum_reports": {
      "type": "integer",
      "minimum": 5,
      "maximum": 30
    },
    "control_policy": {
      "const": "config/operator_control.json"
    },
    "allowed_api_routes": {
      "type": "array",
      "const": [
        "/api/v1/health",
        "/api/v1/overview",
        "/api/v1/context",
        "/api/v1/control",
        "/api/v1/control/run",
        "/api/v1/control/instructions",
        "/api/v1/morning-reports",
        "/api/v1/morning-reports/latest",
        "/api/v1/morning-reports/{date}",
        "/api/v1/ledger",
        "/api/v1/journal"
      ]
    },
    "allowed_methods": {
      "type": "array",
      "const": [
        "GET",
        "HEAD",
        "POST"
      ]
    },
    "allowed_diagnostics": {
      "type": "array",
      "const": [
        "autonomy_service_health",
        "free_source_health",
        "manifest_check",
        "release_provenance"
      ]
    },
    "security_headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "Content-Security-Policy",
        "Cross-Origin-Opener-Policy",
        "Cross-Origin-Resource-Policy",
        "Referrer-Policy",
        "X-Content-Type-Options",
        "X-Frame-Options"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_only",
        "loopback_only",
        "overview_read_only",
        "local_control_enabled",
        "local_runtime_writes_only",
        "fixed_actions_only",
        "arbitrary_shell_allowed",
        "external_network_enabled",
        "external_communications_enabled",
        "account_data_allowed",
        "market_price_data_allowed",
        "report_content_allowed",
        "credentials_allowed",
        "model_invoked",
        "broker_invoked",
        "automatic_instruction_execution",
        "strategy_change_allowed",
        "execution_enabled",
        "options_execution_enabled"
      ],
      "properties": {
        "diagnostic_only": {
          "const": true
        },
        "loopback_only": {
          "const": true
        },
        "overview_read_only": {
          "const": true
        },
        "local_control_enabled": {
          "const": true
        },
        "local_runtime_writes_only": {
          "const": true
        },
        "fixed_actions_only": {
          "const": true
        },
        "arbitrary_shell_allowed": {
          "const": false
        },
        "external_network_enabled": {
          "const": false
        },
        "external_communications_enabled": {
          "const": false
        },
        "account_data_allowed": {
          "const": false
        },
        "market_price_data_allowed": {
          "const": false
        },
        "report_content_allowed": {
          "const": true
        },
        "credentials_allowed": {
          "const": false
        },
        "model_invoked": {
          "const": false
        },
        "broker_invoked": {
          "const": false
        },
        "automatic_instruction_execution": {
          "const": false
        },
        "strategy_change_allowed": {
          "const": false
        },
        "execution_enabled": {
          "const": false
        },
        "options_execution_enabled": {
          "const": false
        }
      }
    }
  }
}
