{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charles.local/schemas/operator_command_receipt.schema.json",
  "title": "Operator Command Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "command_id", "action_id", "label", "requested_utc", "started_utc",
    "finished_utc", "status", "duration_ms", "steps", "safety", "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "operator_command_receipt/1.0"},
    "command_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "action_id": {
      "enum": [
        "broker_boundary_audit", "console_contract_audit", "full_offline_audit",
        "model_governance_audit", "readiness_contract_audit", "system_integrity_audit"
      ]
    },
    "label": {"type": "string", "minLength": 1, "maxLength": 64},
    "requested_utc": {"type": "string", "format": "date-time"},
    "started_utc": {"type": "string", "format": "date-time"},
    "finished_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed", "timed_out"]},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 900000},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "status", "exit_code", "duration_ms", "summary",
          "stdout_sha256", "stderr_sha256"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
          "status": {"enum": ["passed", "failed", "timed_out"]},
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": "integer", "minimum": 0, "maximum": 180000},
          "summary": {"type": "string", "minLength": 1, "maxLength": 120},
          "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "safety": {"$ref": "operator_control_policy.schema.json#/properties/safety"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
