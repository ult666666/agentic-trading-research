{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant_strategy_uniqueness_policy.schema.json",
  "title": "Quant Strategy Uniqueness Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "objective",
    "comparison_input",
    "minimum_aligned_observations",
    "minimum_candidate_active_observations",
    "minimum_common_date_coverage_fraction",
    "maximum_incumbents",
    "maximum_absolute_incumbent_correlation",
    "maximum_active_day_jaccard",
    "minimum_residual_alpha_lower_confidence_bound",
    "minimum_incremental_mean_daily_return_delta",
    "minimum_incremental_sharpe_delta",
    "minimum_incremental_max_drawdown_delta",
    "minimum_incremental_expected_shortfall_delta",
    "expected_shortfall_quantile",
    "confidence_level",
    "normal_critical_value",
    "hac_kernel",
    "hac_lag_rule",
    "incumbent_composite_rule",
    "augmented_portfolio_rule",
    "classification_order",
    "multiple_testing_policy",
    "safety"
  ],
  "properties": {
    "schema": {"const": "quant_strategy_uniqueness_policy/1.0"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "objective": {"type": "string", "minLength": 1},
    "comparison_input": {"const": "hash_valid_quant_portfolio_backtest_daily_net_returns"},
    "minimum_aligned_observations": {"type": "integer", "minimum": 60},
    "minimum_candidate_active_observations": {"type": "integer", "minimum": 20},
    "minimum_common_date_coverage_fraction": {"type": "number", "minimum": 0.95, "maximum": 1},
    "maximum_incumbents": {"type": "integer", "minimum": 1, "maximum": 20},
    "maximum_absolute_incumbent_correlation": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.8},
    "maximum_active_day_jaccard": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.75},
    "minimum_residual_alpha_lower_confidence_bound": {"type": "number", "minimum": 0},
    "minimum_incremental_mean_daily_return_delta": {"type": "number", "minimum": 0},
    "minimum_incremental_sharpe_delta": {"type": "number", "minimum": 0.05},
    "minimum_incremental_max_drawdown_delta": {"type": "number", "minimum": -0.02},
    "minimum_incremental_expected_shortfall_delta": {"type": "number", "minimum": -0.001},
    "expected_shortfall_quantile": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
    "confidence_level": {"const": 0.95},
    "normal_critical_value": {"type": "number", "exclusiveMinimum": 0},
    "hac_kernel": {"const": "bartlett"},
    "hac_lag_rule": {"const": "floor_4_n_over_100_power_2_over_9_capped_n_minus_1"},
    "incumbent_composite_rule": {"const": "equal_weight_daily_return"},
    "augmented_portfolio_rule": {"const": "equal_weight_across_candidate_and_all_incumbents"},
    "classification_order": {
      "const": [
        "insufficient_data",
        "redundant",
        "distinct_but_unproven",
        "incremental_alpha_review_candidate"
      ]
    },
    "multiple_testing_policy": {"const": "diagnostic_requires_separate_locked_holdout_dsr_pbo_and_category_D_review"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "diagnostic_only",
        "execution_enabled",
        "activation_authority",
        "feeds_production",
        "feeds_research_factory",
        "strategy_change_allowed",
        "promotion_gate_change_allowed",
        "profitability_claim_allowed",
        "automatic_promotion_allowed",
        "broker_access",
        "broker_tool_invoked",
        "model_invoked",
        "account_data_allowed",
        "order_data_allowed"
      ],
      "properties": {
        "research_only": {"const": true},
        "diagnostic_only": {"const": true},
        "execution_enabled": {"const": false},
        "activation_authority": {"const": false},
        "feeds_production": {"const": false},
        "feeds_research_factory": {"const": false},
        "strategy_change_allowed": {"const": false},
        "promotion_gate_change_allowed": {"const": false},
        "profitability_claim_allowed": {"const": false},
        "automatic_promotion_allowed": {"const": false},
        "broker_access": {"const": "none"},
        "broker_tool_invoked": {"const": false},
        "model_invoked": {"const": false},
        "account_data_allowed": {"const": false},
        "order_data_allowed": {"const": false}
      }
    }
  }
}
