{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "options_research_ticket.schema.json",
  "title": "Proposed manual options RESEARCH ticket (options research lane, v1)",
  "description": "Output of scripts/options_manual_ticket.py. A PROPOSAL a human may read - never an order, preview, simulation, or confirmation that an order exists. execution_enabled, broker_write_authority and manual_ticket_only are hard-coded constants in the renderer and are constrained here to their only permitted values so a mutated ticket fails validation. v1.1 adds classification_reason_codes so a ticket's classification, size and final recommended action are auditable together; every payoff figure remains gross of fees.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "underlying_ticker", "company_name", "strategy",
    "classification", "classification_reason_codes", "conviction", "research_score",
    "score_band", "catalyst",
    "catalyst_date", "bull_case", "bear_case", "legs", "entry_premium_zone",
    "maximum_acceptable_debit_per_contract", "thesis_invalidation_underlying", "stop_note",
    "underlying_target_1", "underlying_target_2", "maximum_premium_loss_dollars",
    "suggested_maximum_position_size_contracts", "position_size_basis",
    "expected_holding_period_trading_days", "expiration_rationale", "liquidity_assessment",
    "volatility_assessment", "breakeven_underlying", "underlying_move_required_pct",
    "max_profit_dollars", "max_profit_bounded", "scenario_pnl_at_expiration",
    "risk_reward_at_expiration", "option_price_target_1", "option_price_target_2",
    "option_premium_risk_reward", "time_decay_exposure", "volatility_sensitivity",
    "probability_estimates", "assignment_exercise_risk", "fees", "data_timestamps",
    "gate_status", "gate_reason_codes", "analytics_status", "analytics_reason_codes",
    "capability_receipt_status", "limitations", "final_recommended_manual_action",
    "execution_enabled", "broker_write_authority", "manual_ticket_only", "actionable",
    "shadow", "broker_calls_made"
  ],
  "properties": {
    "schema_version": { "const": "options_research_ticket/1.1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "underlying_ticker": { "type": ["string", "null"], "maxLength": 10 },
    "company_name": { "type": ["string", "null"], "maxLength": 200 },
    "strategy": { "enum": ["long_call", "long_put", null] },
    "classification": { "enum": ["RESEARCH_CANDIDATE", "WATCH", "AVOID", "NO_TRADE"] },
    "classification_reason_codes": {
      "type": "array",
      "description": "Stable machine-readable reasons the deterministic matrix in scripts/options_manual_ticket.py assigned this classification (for example no_contract_survived_deterministic_gates). Never an instruction and never an authorization.",
      "items": { "type": "string", "maxLength": 120 }
    },
    "conviction": { "type": ["string", "null"], "maxLength": 200 },
    "research_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "score_band": { "enum": ["a_tier", "b_tier", "watch", "reject"] },
    "catalyst": { "type": ["string", "null"], "maxLength": 2000 },
    "catalyst_date": { "type": ["string", "null"], "maxLength": 32 },
    "bull_case": { "type": ["string", "null"], "maxLength": 4000 },
    "bear_case": { "type": ["string", "null"], "maxLength": 4000 },
    "legs": {
      "type": ["array", "null"],
      "minItems": 1,
      "maxItems": 1,
      "description": "v1 ratifies exactly ONE long leg. Multi-leg structures are refused by scripts/lib/options_analytics.py and cannot reach this renderer.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["side", "quantity_contracts", "option_type", "underlying",
                     "expiration", "strike", "occ_symbol", "contract_multiplier",
                     "open_close"],
        "properties": {
          "side": { "const": "long" },
          "quantity_contracts": { "type": "integer", "minimum": 0 },
          "option_type": { "enum": ["call", "put"] },
          "underlying": { "type": ["string", "null"], "maxLength": 10 },
          "expiration": { "type": ["string", "null"], "maxLength": 32 },
          "strike": { "type": ["number", "null"] },
          "occ_symbol": { "type": ["string", "null"], "maxLength": 64 },
          "contract_multiplier": { "enum": [100, null] },
          "open_close": { "const": "open_long_debit_only" }
        }
      }
    },
    "entry_premium_zone": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["low_per_contract", "high_per_contract", "note"],
      "properties": {
        "low_per_contract": { "type": "number", "exclusiveMinimum": 0 },
        "high_per_contract": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "maximum_acceptable_debit_per_contract": { "type": ["number", "null"] },
    "thesis_invalidation_underlying": { "type": ["number", "null"] },
    "stop_note": { "type": "string", "maxLength": 400 },
    "underlying_target_1": { "type": ["number", "null"] },
    "underlying_target_2": { "type": ["number", "null"] },
    "maximum_premium_loss_dollars": { "type": "number", "minimum": 0 },
    "suggested_maximum_position_size_contracts": { "type": "integer", "minimum": 0 },
    "position_size_basis": { "type": "object" },
    "expected_holding_period_trading_days": { "type": ["integer", "null"], "minimum": 0 },
    "expiration_rationale": { "type": ["string", "null"], "maxLength": 1000 },
    "liquidity_assessment": { "type": ["string", "null"], "maxLength": 1000 },
    "volatility_assessment": { "type": ["string", "null"], "maxLength": 1000 },
    "breakeven_underlying": { "type": ["number", "null"] },
    "underlying_move_required_pct": { "type": ["number", "null"] },
    "max_profit_dollars": { "type": ["number", "null"] },
    "max_profit_bounded": { "type": "boolean" },
    "scenario_pnl_at_expiration": { "type": "object" },
    "risk_reward_at_expiration": { "type": ["number", "null"] },
    "option_price_target_1": { "const": "UNAVAILABLE_MODEL_UNVERIFIED" },
    "option_price_target_2": { "const": "UNAVAILABLE_MODEL_UNVERIFIED" },
    "option_premium_risk_reward": { "const": "UNAVAILABLE_MODEL_UNVERIFIED" },
    "time_decay_exposure": { "type": ["object", "string", "null"] },
    "volatility_sensitivity": { "type": ["object", "string", "null"] },
    "probability_estimates": { "type": "object" },
    "assignment_exercise_risk": { "type": "object" },
    "fees": { "type": "object" },
    "data_timestamps": {
      "type": "object",
      "required": ["generated_pt", "generated_et", "generated_utc",
                   "target_session_date", "data_cutoff_utc"]
    },
    "gate_status": { "enum": ["BLOCKED", "PREOPEN_WATCH_ONLY", "SHADOW_OPTIONS_CANDIDATE",
                              null] },
    "gate_reason_codes": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
    "analytics_status": { "type": ["string", "null"], "maxLength": 32 },
    "analytics_reason_codes": { "type": "array",
                                "items": { "type": "string", "maxLength": 120 } },
    "capability_receipt_status": { "type": "string", "maxLength": 64 },
    "limitations": { "type": "array", "minItems": 6,
                     "items": { "type": "string", "maxLength": 600 } },
    "final_recommended_manual_action": { "type": "string", "maxLength": 1000 },
    "execution_enabled": { "const": false },
    "broker_write_authority": { "const": false },
    "manual_ticket_only": { "const": true },
    "actionable": { "const": false },
    "shadow": { "const": true },
    "broker_calls_made": { "const": 0 }
  }
}
