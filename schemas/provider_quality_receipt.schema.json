{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider_quality_receipt.schema.json",
  "title": "Daily provider quality receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "config_sha256",
    "target_session_date",
    "generated_utc",
    "status",
    "providers",
    "missing_providers",
    "invalid_observations",
    "license_gate",
    "cross_provider",
    "hard_gate_failures",
    "quality_threshold_failures",
    "research_only",
    "production_authority",
    "execution_enabled",
    "feeds_production_scoring",
    "strategy_activation_allowed",
    "governance_approval_required",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "provider_quality_receipt/1.0"},
    "campaign_id": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_session_date": {"type": "string", "format": "date"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["collecting", "blocked", "hard_gate_failed", "quality_failed", "quality_observation_ready"]},
    "providers": {"type": "object"},
    "missing_providers": {"type": "array", "items": {"type": "string"}},
    "invalid_observations": {"type": "object"},
    "license_gate": {"type": "object"},
    "cross_provider": {"type": "object"},
    "hard_gate_failures": {"type": "array", "items": {"type": "string"}},
    "quality_threshold_failures": {"type": "array", "items": {"type": "string"}},
    "research_only": {"const": true},
    "production_authority": {"const": false},
    "execution_enabled": {"const": false},
    "feeds_production_scoring": {"const": false},
    "strategy_activation_allowed": {"const": false},
    "governance_approval_required": {"const": true},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
