{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sec_access_readiness.schema.json",
  "title": "Redacted SEC automated-access readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "target_session_date", "generated_utc", "status", "ready", "reason_codes", "identity", "local_storage", "transport", "policy_path", "policy_sha256", "network_invoked", "safety", "artifact_sha256"],
  "properties": {
    "schema": {"const": "sec_access_readiness/1.0"},
    "version": {"const": "1.0.0"},
    "target_session_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "missing", "at_issue"]},
    "ready": {"type": "boolean"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,95}$"}},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["configured", "consent_configured", "source", "consent_source", "value_exposed", "value_hash_persisted"],
      "properties": {
        "configured": {"type": "boolean"},
        "consent_configured": {"type": "boolean"},
        "source": {"type": ["string", "null"], "enum": ["env", "secrets_file", null]},
        "consent_source": {"type": ["string", "null"], "enum": ["env", "secrets_file", null]},
        "value_exposed": {"const": false},
        "value_hash_persisted": {"const": false}
      }
    },
    "local_storage": {
      "type": "object", "additionalProperties": false,
      "required": ["secrets_file_present", "secrets_file_mode", "secrets_directory_mode", "permissions_safe"],
      "properties": {
        "secrets_file_present": {"type": "boolean"},
        "secrets_file_mode": {"type": ["string", "null"], "pattern": "^[0-7]{3,4}$"},
        "secrets_directory_mode": {"type": ["string", "null"], "pattern": "^[0-7]{3,4}$"},
        "permissions_safe": {"type": ["boolean", "null"]}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "project_max_requests_per_second", "sec_published_max_requests_per_second", "minimum_request_gap_seconds", "redirects_allowed", "maximum_response_bytes", "scheduled_probe"],
      "properties": {
        "host": {"const": "data.sec.gov"},
        "project_max_requests_per_second": {"const": 5},
        "sec_published_max_requests_per_second": {"const": 10},
        "minimum_request_gap_seconds": {"const": 0.2},
        "redirects_allowed": {"const": false},
        "maximum_response_bytes": {"const": 10000000},
        "scheduled_probe": {"const": false}
      }
    },
    "policy_path": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network_invoked": {"const": false},
    "safety": {"$ref": "sec_access_policy.schema.json#/$defs/safety"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
