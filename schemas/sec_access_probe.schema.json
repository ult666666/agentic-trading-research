{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sec_access_probe.schema.json",
  "title": "Attended SEC network probe receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "target_session_date", "generated_utc", "status", "ok", "reason_codes", "endpoint_host", "probe_cik", "external_pii_transmission_confirmed", "network_invoked", "response", "identity_value_exposed", "identity_hash_persisted", "raw_response_persisted", "policy_path", "policy_sha256", "safety", "artifact_sha256"],
  "properties": {
    "schema": {"const": "sec_access_probe/1.0"},
    "version": {"const": "1.0.0"},
    "target_session_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "blocked", "failed"]},
    "ok": {"type": "boolean"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,95}$"}},
    "endpoint_host": {"const": "data.sec.gov"},
    "probe_cik": {"const": "0000320193"},
    "external_pii_transmission_confirmed": {"type": "boolean"},
    "network_invoked": {"type": "boolean"},
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_object", "cik_match", "recent_filings_array_present"],
      "properties": {
        "payload_object": {"type": ["boolean", "null"]},
        "cik_match": {"type": ["boolean", "null"]},
        "recent_filings_array_present": {"type": ["boolean", "null"]}
      }
    },
    "identity_value_exposed": {"const": false},
    "identity_hash_persisted": {"const": false},
    "raw_response_persisted": {"const": false},
    "policy_path": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safety": {"$ref": "sec_access_policy.schema.json#/$defs/safety"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
