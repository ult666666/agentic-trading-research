{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant_strategy_shadow_forward_run.schema.json",
  "description": "Exact-denominator comparison receipt over common inputs. Its expected denominator is a shared caller-frozen replay-spec self-commitment, not proof of plan bytes or approval. The run remains caller-dated research metadata and is not a trusted-clock or canonical-singleton receipt.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "tool", "algorithm_version", "artifact_valid", "plan_id", "plan_sha256", "session_date", "generated_at_utc", "status", "reason_codes", "candidate", "benchmark", "incumbents", "expected_run_denominator_sha256", "result_denominator", "results_sha256", "limitations", "run_sha256", "research_only", "diagnostic_only", "execution_enabled", "activation_authority", "strategy_change_allowed", "feeds_production", "feeds_buy_gate", "feeds_freeze_gate", "feeds_risk_gate", "profitability_claim_allowed", "broker_access", "broker_tool_invoked", "account_data_allowed", "order_data_allowed", "actual_orders_count", "network_invoked", "model_invoked"],
  "properties": {
    "schema": {"const": "quant_strategy_shadow_forward_run/1.0"}, "tool": {"const": "quant.strategy_shadow_forward"}, "algorithm_version": {"const": "catalyst_continuation_shadow_forward/1.0.0"}, "artifact_valid": {"const": true},
    "plan_id": {"$ref": "#/$defs/id"}, "plan_sha256": {"$ref": "#/$defs/sha"}, "session_date": {"$ref": "#/$defs/date"}, "generated_at_utc": {"$ref": "#/$defs/utc"}, "status": {"enum": ["complete", "unavailable"]}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate": {"allOf": [{"$ref": "#/$defs/resultRef"}, {"properties": {"role": {"const": "candidate"}}}]},
    "benchmark": {"allOf": [{"$ref": "#/$defs/resultRef"}, {"properties": {"role": {"const": "benchmark"}}}]},
    "incumbents": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/resultRef"}, {"properties": {"role": {"const": "incumbent"}}}]}},
    "expected_run_denominator_sha256": {"$ref": "#/$defs/sha"}, "result_denominator": {"$ref": "#/$defs/denominator"}, "results_sha256": {"$ref": "#/$defs/sha"}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "run_sha256": {"$ref": "#/$defs/sha"},
    "research_only": {"const": true}, "diagnostic_only": {"const": true}, "execution_enabled": {"const": false}, "activation_authority": {"const": false}, "strategy_change_allowed": {"const": false}, "feeds_production": {"const": false}, "feeds_buy_gate": {"const": false}, "feeds_freeze_gate": {"const": false}, "feeds_risk_gate": {"const": false}, "profitability_claim_allowed": {"const": false}, "broker_access": {"const": "none"}, "broker_tool_invoked": {"const": false}, "account_data_allowed": {"const": false}, "order_data_allowed": {"const": false}, "actual_orders_count": {"const": 0}, "network_invoked": {"const": false}, "model_invoked": {"const": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "resultRef": {"type": "object", "additionalProperties": false, "required": ["role", "strategy_id", "path", "file_sha256", "result_sha256", "replay_spec_sha256", "status"], "properties": {"role": {"enum": ["candidate", "benchmark", "incumbent"]}, "strategy_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "file_sha256": {"$ref": "#/$defs/sha"}, "result_sha256": {"$ref": "#/$defs/sha"}, "replay_spec_sha256": {"$ref": "#/$defs/sha"}, "status": {"enum": ["complete", "unavailable"]}}},
    "denominator": {"type": "object", "additionalProperties": false, "required": ["candidate_strategy_id", "benchmark_strategy_id", "incumbent_strategy_ids", "expected_strategy_ids", "expected_count", "result_count", "all_present_once", "expected_run_denominator_sha256", "denominator_sha256"], "properties": {"candidate_strategy_id": {"$ref": "#/$defs/id"}, "benchmark_strategy_id": {"$ref": "#/$defs/id"}, "incumbent_strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "expected_strategy_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "expected_count": {"type": "integer", "minimum": 3}, "result_count": {"type": "integer", "minimum": 3}, "all_present_once": {"const": true}, "expected_run_denominator_sha256": {"$ref": "#/$defs/sha"}, "denominator_sha256": {"$ref": "#/$defs/sha"}}}
  }
}
