+def _observation_projection_consistent(natural_states: Any,
+                                       workflow_statuses: Any) -> bool:
+    """Shared producer/validator predicate for observation eligibility.
 
+    2026-07-17 unification: evaluate() previously omitted the projection-consistency
+    terms that validate_receipt() required inside observation_expected, so on a session
+    with an at-issue workflow the producer could emit a receipt its own validator
+    rejected as receipt_observation_semantics_invalid. Both sides now call this one
+    predicate and can no longer drift.
+    """
+    allowed_workflow_statuses = {
+        "intake": {"healthy", "degraded"},
+        "macro_refresh": {"healthy", "degraded"},
+        "morning": {"healthy", "degraded"},
+        "post_open": {"healthy", "degraded", "skipped_expected"},
+        "post_close": {"healthy", "degraded"},
+    }
+    state_health_mapping = {
+        "completed": "healthy", "degraded": "degraded", "skipped": "skipped_expected",
+    }
+    return bool(
+        isinstance(natural_states, dict)
+        and set(natural_states) == set(WORKFLOWS)
+        and all(value in post_close_finality.TERMINAL_STATES
+                for value in natural_states.values())
+        and isinstance(workflow_statuses, dict)
+        and set(workflow_statuses) == set(WORKFLOWS)
+        and all(workflow_statuses.get(name) in allowed_workflow_statuses[name]
+                for name in WORKFLOWS)
+        and all(state_health_mapping.get(natural_states[name]) == workflow_statuses[name]
+                for name in WORKFLOWS))
+
+
